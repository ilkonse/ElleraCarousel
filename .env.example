# Copia questo file in ".env" e personalizza i valori prima di avviare il server.

# Porta su cui ascolta il server
PORT=3000

# Segreto usato per firmare i cookie di sessione: obbligatorio in produzione.
# Genera un valore casuale lungo, es. con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-questo-valore-con-una-stringa-casuale-lunga

# Impostare a "true" solo quando il sito gira dietro HTTPS (produzione).
# In HTTPS il cookie di sessione viene marcato "secure" e non viaggia in chiaro.
COOKIE_SECURE=false

# Nome mostrato nel <title> e nell'header del pannello admin.
SITE_NAME="Ellera Polcanto"
